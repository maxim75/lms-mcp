# --- Lyrion Music Server -----------------------------------------------------
# Address of your LMS. Inside a container, localhost is the container itself, so
# use the LAN address (or hostname) of the machine running Lyrion.
LMS_HOST=192.168.1.10
LMS_PORT=9000
LMS_PROTOCOL=http
# LMS_BASE_URL=https://music.example.com/lms   # overrides host/port/protocol
LMS_TIMEOUT=10

# Optional HTTP basic auth, if your LMS requires a login.
# LMS_USERNAME=
# LMS_PASSWORD=

# Player used when a tool call omits `player`. A name or a MAC address.
# LMS_DEFAULT_PLAYER=Kitchen

# Registers wipecache, stopserver, restartserver, pref writes and the
# favorite/playlist deletion tools. Off by default.
LMS_ENABLE_DESTRUCTIVE=false

# --- MCP endpoint ------------------------------------------------------------
# Clients must send: Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# Set to true only to run the endpoint with no authentication at all.
# MCP_ALLOW_ANONYMOUS=false

# Comma-separated Host/Origin allow-list. Leave unset behind a reverse proxy.
# MCP_ALLOWED_HOSTS=lms-mcp.example.com

LOG_LEVEL=INFO
